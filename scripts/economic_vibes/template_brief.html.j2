<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Economic Vibes — Morning Brief · {{ date_long }}</title>
<style>
  @page { size:A4; margin:12mm 11mm 17mm 11mm; @bottom-center{ content:element(foot); } }
  *{ box-sizing:border-box; }
  html,body{ margin:0; padding:0; }
  body{ font-family:"Segoe UI","Helvetica Neue",Arial,sans-serif; font-size:14px; line-height:1.5;
    color:#123; background:#EBFAFB; -webkit-print-color-adjust:exact; print-color-adjust:exact; }
  .page{ background:#EBFAFB; padding:0 14px; }
  a{ color:#0A7E8C; text-decoration:none; border-bottom:1px solid #C6DA0B; font-weight:600; }
  .masthead{ background:#FFFFFF; color:#0A2540; padding:14px 20px 12px; border-radius:8px 8px 0 0;
    border:1px solid #D4EFF2; border-bottom:none; }
  .mast-row{ display:flex; justify-content:space-between; align-items:flex-end; }
  .mast-lock{ display:flex; align-items:center; }
  .mast-lock .logo{ height:38px; width:auto; display:block; }
  .mast-lock .divider{ color:#C6D8DC; font-weight:400; padding:0 11px; font-size:26px; }
  .mast-lock .pub{ color:#0A7E8C; font-weight:800; font-size:17.5px; white-space:nowrap; }
  .masthead .sub{ margin:7px 0 0; font-size:11.5px; color:#5A7480; font-weight:500; letter-spacing:.2px; }
  .mast-date{ text-align:right; font-size:11.5px; color:#0A7E8C; font-weight:700; line-height:1.4; white-space:nowrap; }
  .mast-date b{ font-size:13px; color:#0A2540; }
  .colorbar{ display:flex; height:8px; width:100%; overflow:hidden; }
  .colorbar > i{ flex:1; display:block; height:100%; }
  .foot{ position:running(foot); }
  .foot .fbar{ display:flex; height:7px; width:100%; overflow:hidden; }
  .foot .fbar i{ flex:1; display:block; height:100%; }
  .foot .fstrip{ background:#0A7E8C; color:#EAFDFF; font-size:9px; text-align:center; padding:4px 6px; font-weight:600; }
  .body{ padding:10px 6px 4px; }
  h2.sec{ font-size:15px; color:#fff; background:#0FA3B0; margin:8px 0 6px; padding:5px 12px;
    border-radius:5px; font-weight:700; letter-spacing:.2px; }
  h2.sec .n{ color:#C6DA0B; font-weight:900; margin-right:8px; }
  h3.sub{ font-size:13px; color:#08616C; margin:8px 0 3px; font-weight:800;
    border-bottom:2px solid #C6DA0B; padding-bottom:3px; }
  p{ margin:6px 0; text-align:justify; }
  b,strong{ color:#08616C; }
  .pos{ color:#0E9F6E; font-weight:700; } .neg{ color:#D8434E; font-weight:700; }
  ul.five{ list-style:none; margin:5px 0; padding:0; }
  ul.five li{ padding:6px 10px 6px 13px; margin:4.5px 0; background:#fff; border:1px solid #BDE9ED;
    border-left:4px solid #0FA3B0; border-radius:0 7px 7px 0; text-align:justify; page-break-inside:avoid; }
  .chip{ display:inline-block; background:#C6DA0B; color:#46520A; font-weight:800; font-size:10px;
    padding:1px 8px; border-radius:3px; margin-right:6px; text-transform:uppercase; letter-spacing:.3px; }
  .news{ margin:3px 0 2px; padding-left:16px; } .news li{ margin:3.5px 0; text-align:justify; }
  .synth{ background:#fff; border:1px solid #BDE9ED; border-radius:7px; padding:6px 11px; margin:4px 0;
    page-break-inside:avoid; }
  .synth b{ color:#08616C; }
  table{ width:100%; border-collapse:collapse; margin:5px 0 3px; table-layout:fixed; font-size:10.8px; page-break-inside:avoid; }
  thead th{ background:#0A7E8C; color:#fff; font-weight:700; font-size:11px; text-align:left;
    padding:5px 7px; vertical-align:bottom; white-space:normal; }
  tbody td{ padding:4px 6px; border-bottom:1px solid #D4EFF2; vertical-align:top; line-height:1.35; }
  tbody tr:nth-child(even){ background:#F4FCFD; }
  .disc{ font-size:9.8px; line-height:1.42; color:#4A6068; background:#DFF6F8; border:1px solid #BDE9ED;
    border-radius:6px; padding:7px 11px; margin-top:8px; text-align:justify; page-break-inside:avoid; }
  .snap{ display:flex; gap:7px; margin:4px 0 2px; }
  .snap .c2{ flex:1 1 0; min-width:0; background:#fff; border:1px solid #BDE9ED; border-top:4px solid #0FA3B0;
    border-radius:7px; padding:7px 8px; }
  .snap .l{ font-size:9.5px; color:#5F7400; text-transform:uppercase; font-weight:800; letter-spacing:.3px; }
  .snap .v{ font-size:15px; font-weight:800; color:#0A7E8C; white-space:nowrap; line-height:1.2; }
  .snap .d{ font-size:9.5px; font-weight:700; margin-top:1px; }
  .lvl{ display:flex; gap:7px; margin:6px 0 2px; }
  .lvl .c3{ flex:1 1 0; background:#fff; border:1px solid #BDE9ED; border-left:4px solid #C6DA0B;
    border-radius:0 7px 7px 0; padding:6px 9px; }
  .lvl .l{ font-size:9.5px; color:#5F7400; text-transform:uppercase; font-weight:800; letter-spacing:.3px; }
  .lvl .v{ font-size:14px; font-weight:800; color:#0A7E8C; }
  .lvl .d{ font-size:9.5px; margin-top:1px; }
  .synth.flow{ page-break-inside:auto; }
  .tag{ font-size:9px; font-weight:800; color:#0A7E8C; }
</style>
</head>
<body>
<div class="page">
  <div class="foot">
    <div class="fbar">
      <i style="background:#0040D9;"></i><i style="background:#00838F;"></i><i style="background:#00BCD4;"></i>
      <i style="background:#AEEA00;"></i><i style="background:#FDD835;"></i><i style="background:#FFC400;"></i>
      <i style="background:#F26122;"></i><i style="background:#D81B60;"></i><i style="background:#9C27B0;"></i>
    </div>
    <div class="fstrip">ContexAi — Economic Vibes · A ContexAi Research Product · contexai.org · Delivered ~06:30 AM PKT · WhatsApp Channel: Economic Vibes</div>
  </div>

  <div class="masthead">
    <div class="mast-row">
      <div class="mast-lock"><img class="logo" src="contexai_group_logo.png" alt="ContexAi Group"><span class="divider">|</span><span class="pub">Economic Vibes — Morning Brief</span></div>
      <div class="mast-date"><b>{{ date_long }}</b><br>Morning Edition · PKT</div>
    </div>
    <div class="sub">ContexAi Research Desk · Sourced via Reuters, CNBC, Business Recorder, Express Tribune, Mettis Global, AGBI, Gulf News, S&amp;P Global, Kitco, SBP &amp; Regulatory Trackers · For the C-Suite &amp; HNW Investor · <b>V</b> = verified vs licensed media/official portal · <b>EST.</b> = ContexAi desk estimate</div>
  </div>
  <div class="colorbar">
    <i style="background:#0040D9;"></i><i style="background:#00838F;"></i><i style="background:#00BCD4;"></i>
    <i style="background:#AEEA00;"></i><i style="background:#FDD835;"></i><i style="background:#FFC400;"></i>
    <i style="background:#F26122;"></i><i style="background:#D81B60;"></i><i style="background:#9C27B0;"></i>
  </div>

  <div class="body">
    <div class="snap">
      {% for c in snapshot %}<div class="c2"><div class="l">{{ c.label }} <span class="tag">{{ c.tag }}</span></div><div class="v">{{ c.value }}</div><div class="d {{ c.delta_class }}">{{ c.delta }}</div></div>
      {% endfor %}
    </div>

    <h2 class="sec"><span class="n">01</span>Five Things You Need To Know To Start Your Day</h2>
    <ul class="five">
      {% for f in five_things %}<li><span class="chip">{{ f.chip }}</span> {{ f.html }} Sentiment: <span class="{{ f.sentiment_class }}">{{ f.sentiment }}</span>.</li>
      {% endfor %}
    </ul>

    <h2 class="sec"><span class="n">02</span>Regional Market &amp; Economic Matrix</h2>
    <h3 class="sub">A. Local Market — Pakistan Focus</h3>
    <div class="synth">{{ matrix.local_html }}</div>
    <h3 class="sub">B. GCC &amp; Middle East</h3>
    <div class="synth">{{ matrix.gcc_html }}</div>
    <h3 class="sub">C. Global Intelligence</h3>
    <div class="synth">{{ matrix.global_html }}</div>

    <h2 class="sec"><span class="n">03</span>Legislative &amp; Regulatory Tracker — Who Wins, Who Loses</h2>
    <table>
      <colgroup><col style="width:15%"><col style="width:29%"><col style="width:21%"><col style="width:35%"></colgroup>
      <thead><tr><th>Jurisdiction</th><th>Legislation / Policy Change</th><th>Affected Sector(s)</th><th>Net Impact &amp; Strategic Outlook</th></tr></thead>
      <tbody>
        {% for r in legislative %}<tr><td><b>{{ r.jur }}</b></td><td>{{ r.policy_html }}</td><td>{{ r.sectors }}</td><td>{{ r.impact_html }}</td></tr>
        {% endfor %}
      </tbody>
    </table>

    <h2 class="sec"><span class="n">04</span>The Day Ahead — KSE-100 Levels &amp; Desk Stance</h2>
    <div class="lvl">
      <div class="c3"><div class="l">Support <span class="tag">EST.</span></div><div class="v">{{ levels.support }}</div><div class="d">{{ levels.support_note }}</div></div>
      <div class="c3"><div class="l">Pivot <span class="tag">EST.</span></div><div class="v">{{ levels.pivot }}</div><div class="d">{{ levels.pivot_note }}</div></div>
      <div class="c3"><div class="l">Resistance <span class="tag">EST.</span></div><div class="v">{{ levels.resistance }}</div><div class="d">{{ levels.resistance_note }}</div></div>
    </div>
    <div class="synth flow">{{ desk_stance_html }}</div>

    <div class="disc"><b>Disclaimer:</b> {{ disclaimer }}</div>
  </div>
</div>
</body>
</html>
